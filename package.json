{
  "name": "firstlight",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode extension",
    "dev:online": "vite --mode online",
    "build": "npm run build:extension && npm run build:online",
    "build:extension": "vite build --mode extension && esbuild src/extension/background.ts --bundle --format=iife --platform=browser --target=chrome120 --minify --outfile=dist/extension/background.js && node scripts/verify-extension.mjs",
    "build:online": "vite build --mode online",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.78",
    "gsap": "^3.13.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/merge": "^6.10.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  }
}
