{
  "name": "firstlight",
  "version": "0.1.1",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --mode extension",
    "dev:online": "vite --mode online",
    "build": "npm run build:extension && npm run build:online",
    "build:extension": "vite build --mode extension && esbuild src/extension/background.ts --bundle --format=iife --platform=browser --target=chrome120 --minify --outfile=dist/extension/background.js && node scripts/verify-extension.mjs",
    "build:online": "vite build --mode online",
    "extract-patch": "node scripts/extract-git-patch.mjs",
    "preview:online": "vite preview --outDir dist/online --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 36",
    "format:check": "prettier --check package.json eslint.config.js playwright.config.ts vitest.config.ts 'e2e/**/*.ts' && git diff --check",
    "format": "prettier --write package.json eslint.config.js playwright.config.ts vitest.config.ts 'e2e/**/*.ts'",
    "audit:prod": "npm audit --omit=dev",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run test:e2e && npm run audit:prod"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/merge": "^6.10.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@paper-design/shaders": "^0.0.78",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  }
}
